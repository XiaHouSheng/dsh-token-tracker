{
  // Self-contained type-declaration build for the standalone dsh-token-tracker.
  //
  // Unlike the in-repo tsconfig.json (which extends the harness
  // tsconfig.base.client.json and uses project references into the monorepo),
  // this config has no harness dependency: it compiles only `src/`, resolves the
  // `@deepseek-ai/*` peer packages to local ambient stubs under `types.stub/`,
  // and emits declarations (and their JS/map companions) into `lib/types` so
  // `node pack.mjs` can pack a complete standalone tarball.
  //
  // Only `typescript`, `@types/node`, `@types/react`, and `react` are required;
  // install them with `pnpm install` at the repo root.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "lib/types",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "paths": {
      "@deepseek-ai/dsh-typert-protocol": ["./types.stub/dsh-typert-protocol/index.d.ts"],
      "@deepseek-ai/cordis": ["./types.stub/dsh-cordis/index.d.ts"],
      "@deepseek-ai/dsh-session": ["./types.stub/dsh-session/index.d.ts"],
      "@deepseek-ai/dsh-session/types": ["./types.stub/dsh-session-types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-slots": ["./types.stub/dsh-client-ui-slots/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-conversation/client": ["./types.stub/dsh-client-ui-conversation-client/index.d.ts"],
      "@deepseek-ai/dsh-client-runtime/client": ["./types.stub/dsh-client-runtime-client/index.d.ts"],
      "@deepseek-ai/dsh-invariants": ["./types.stub/dsh-invariants/index.d.ts"],
      "@deepseek-ai/dsh-session-query": ["./types.stub/empty/index.d.ts"],
      "@deepseek-ai/dsh-host-webserver": ["./types.stub/empty/index.d.ts"],
      "@deepseek-ai/dsh-token-meter": ["./types.stub/empty/index.d.ts"]
    }
  },
  "include": ["src"]
}
